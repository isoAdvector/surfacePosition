FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     interIsoFoam;

startFrom       startTime;

startTime       0;

stopAt          endTime;

endTime         0.6;

deltaT          0.001;

writeControl    adjustable;

writeInterval   0.1;

purgeWrite      0;

writeFormat     binary;

writePrecision  12;

writeCompression off;

timeFormat      general;

timePrecision   8;

runTimeModifiable no;

adjustTimeStep  yes;

maxCo           0.5;

maxAlphaCo      0.5;

maxDeltaT       1;

#include "lineLocations"

functions
{
    surfacePosition1
    {
        type            surfacePosition;
        libs            (surfacePosition);
        locations       $lineLocations;
        alpha           alpha.water;
        direction       (0 0 -1);
        checkLineCells  true;
        writeControl    timeStep;
        writeInterval   1;
    }

    interfaceHeight1
    {
        type            interfaceHeight;
        libs            (fieldFunctionObjects);
        locations       $lineLocations;
        alpha           alpha.water;
        direction       (0 0 -1);
        writeControl    timeStep;
        writeInterval   1;
    }
}

