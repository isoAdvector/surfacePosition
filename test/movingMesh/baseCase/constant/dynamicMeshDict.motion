FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      dynamicMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Solid body oscillation in x: the cells under the fixed sampling lines change
// continuously (amplitude 2.5 cells)

dynamicFvMesh   dynamicMotionSolverFvMesh;

motionSolverLibs (fvMotionSolvers);

motionSolver    solidBody;

solidBodyMotionFunction oscillatingLinearMotion;

oscillatingLinearMotionCoeffs
{
    amplitude       (0.05 0 0);
    omega           5.3;
}

// ************************************************************************* //
