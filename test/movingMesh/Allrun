cd "${0%/*}" || exit 1
#------------------------------------------------------------------------------
# surfacePosition on changing meshes: a standing wave with adaptive mesh
# refinement (amrBase) and with a solid body oscillation of the mesh
# (motionBase), each copied and run with its Allrun in serial and parallel at
# the same time (only serial if SERIAL_ONLY is set), and compared with
# interfaceHeight by compare.py. checkLineCells compares the line cells after
# every rebuild with a full search.
#------------------------------------------------------------------------------

for name in amr motion
do
    rm -rf "$name" "${name}_parallel"
    cp -r "${name}Base" "$name"
    if [ -z "$SERIAL_ONLY" ]
    then
        cp -r "${name}Base" "${name}_parallel"
        "${name}_parallel/Allrun" -parallel &
    fi
    "$name/Allrun"
    wait
done

python3 compare.py amr motion | tee log.compare
exit "${PIPESTATUS[0]}"

#------------------------------------------------------------------------------
