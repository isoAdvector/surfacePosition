cd "${0%/*}" || exit 1
. ${WM_PROJECT_DIR:?}/bin/tools/RunFunctions        # Tutorial run functions
#------------------------------------------------------------------------------
# A standing wave (3D, 2 cells across) with the surfacePosition and
# interfaceHeight function objects on a mesh with adaptive refinement at the
# interface, in serial, or with -parallel on the processors of
# system/decomposeParDict.
#
# Usage: Allrun [-parallel]
#------------------------------------------------------------------------------

restore0Dir
runApplication blockMesh
runApplication setAlphaField

if isParallel "$@"
then
    runApplication decomposePar -cellDist
    runParallel $(getApplication)
else
    runApplication $(getApplication)
fi

