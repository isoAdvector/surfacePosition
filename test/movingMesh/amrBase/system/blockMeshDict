FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      blockMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

scale   1;

L   1;
nx  20;

// 3D with 2 cells across: dynamicRefineFvMesh refines in all three
// directions. The lines at y = 0 lie on the internal faces between the two
// cell layers.
y1  -0.05;
y2  0.05;
ny  2;

H   1;
nz  20;

vertices
(
    (0 $y1 0)
    ($L $y1 0)
    ($L $y2 0)
    (0 $y2 0)
    (0 $y1 $H)
    ($L $y1 $H)
    ($L $y2 $H)
    (0 $y2 $H)
);

blocks
(
    hex (0 1 2 3 4 5 6 7) ($nx $ny $nz) simpleGrading (1 1 1)
);

edges
(
);

boundary
(
    left
    {
        type patch;
        faces
        (
            (0 4 7 3)
        );
    }
    right
    {
        type patch;
        faces
        (
            (1 2 6 5)
        );
    }
    top
    {
        type patch;
        faces
        (
            (4 5 6 7)
        );
    }
    bottom
    {
        type patch;
        faces
        (
            (0 3 2 1)
        );
    }
    front
    {
        type symmetryPlane;
        faces
        (
            (0 1 5 4)
        );
    }
    back
    {
        type symmetryPlane;
        faces
        (
            (2 3 7 6)
        );
    }
);

mergePatchPairs
(
);

