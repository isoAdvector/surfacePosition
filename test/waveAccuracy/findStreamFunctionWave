#------------------------------------------------------------------------------
# Prints the src/streamFunctionWave directory of the streamFunctionWave
# repository found next to the current directory or any directory above it.
#------------------------------------------------------------------------------

dir=$(pwd)
while [ "$dir" != / ]
do
    src="$dir/streamFunctionWave/src/streamFunctionWave"
    if [ -f "$src/streamFunctionWave.H" ]
    then
        echo "$src"
        exit 0
    fi
    dir=$(dirname "$dir")
done

echo "streamFunctionWave not found; set STREAMFUNCTIONWAVE_SRC" >&2
exit 1

