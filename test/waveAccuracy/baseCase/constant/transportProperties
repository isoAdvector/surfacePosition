FoamFile
{
    version         2;
    format          ascii;
    class           dictionary;
    location        "constant";
    object          transportProperties;
}

phases          ( water air );

water
{
    transportModel  Newtonian;
    nu              0;
    rho             1000;
}

air
{
    transportModel  Newtonian;
    nu              0;
    rho             1;
}

sigma           0;


