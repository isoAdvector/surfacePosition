FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      blockMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

convertToMeters 1;

y1 -.1;
y2 .1;
ny 1;

L 3.7873860376294;
nx 95;

z1 -0.4;
z2 0.4;
nz 20;

vertices
(
    (0 $y1 $z1)
    ($L $y1 $z1)
    ($L $y2 $z1)
    (0 $y2 $z1)
    (0 $y1 $z2)
    ($L $y1 $z2)
    ($L $y2 $z2)
    (0 $y2 $z2)
);

blocks
(
    hex (0 1 2 3 4 5 6 7) ($nx $ny $nz) simpleGrading (1 1 1)
);

edges
(
);

boundary
(
    top
    {
        type patch;
        faces
        (
            (4 5 6 7)
        );
    }
    bottom
    {
        type patch;
        faces
        (
            (0 3 2 1)
        );
    }
    left
    {
        type cyclic;
        neighbourPatch right;
//        type patch;
        faces
        (
            (0 4 7 3)
        );
    }
    right
    {
        type cyclic;
        neighbourPatch left;
        faces
        (
            (1 2 6 5)
        );
    }
    frontAndBack
    {
        type empty;
        faces
        (
            (0 1 5 4)
            (2 3 7 6)
        );
    }
);

mergePatchPairs
(
);

