FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    object      U;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 1 -1 0 0 0 0];

internalField   uniform (0 0 0);

boundaryField
{
    left            
    {
        type            cyclic;
    }
    right
    {
        type            cyclic;
    }
    bottom
    {
	type            slip;
    }
    top              
    {
        type            pressureInletOutletVelocity;
        phi             phi;
        rho             rho;
        value           $internalField;
    }
    frontAndBack
    {
        type            empty;
    }
}

