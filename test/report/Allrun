cd "${0%/*}" || exit 1
#------------------------------------------------------------------------------
# The report on surfacePosition from the results of the executed test suite
# (../Allrun): numbers and tables, ParaView figures, the PDF, the wave error
# plot as an image, and the README.md of the repository (a Markdown version of
# the report). The figures, the PDF and the README are committed.
#
# PVBATCH: the pvbatch executable (default: pvbatch on the path, else the
# newest ParaView in ~/ParaView)
#------------------------------------------------------------------------------

pvbatch=${PVBATCH:-$(command -v pvbatch || ls -d "$HOME"/ParaView/*/bin/pvbatch 2>/dev/null | tail -1)}
[ -x "$pvbatch" ] || { echo "pvbatch not found; set PVBATCH" >&2; exit 1; }

python3 makeData.py || exit 1
"$pvbatch" makeFigures.py > log.makeFigures 2>&1 || { tail log.makeFigures; exit 1; }
# Crop the white margins of the figures
python3 - <<'PYEOF' || exit 1
import glob
from PIL import Image, ImageChops
for f in glob.glob("figures/*.png"):
    im = Image.open(f).convert("RGB")
    box = ImageChops.difference(im, Image.new("RGB", im.size, "white")).getbbox()
    if box:
        m = 10
        box = (max(box[0] - m, 0), max(box[1] - m, 0),
               min(box[2] + m, im.width), min(box[3] + m, im.height))
        im.crop(box).save(f)
PYEOF

latexmk -pdf -interaction=nonstopmode -halt-on-error report.tex > log.latexmk 2>&1 \
 || { grep -A5 '^!' report.log; exit 1; }
echo "Wrote $(pwd)/report.pdf"

# The wave error plot of the report as an image for the README
latexmk -pdf -interaction=nonstopmode -halt-on-error waveErrorFigure.tex \
    > log.waveErrorFigure 2>&1 \
 || { grep -A5 '^!' waveErrorFigure.log; exit 1; }
pdftoppm -r 150 -png -singlefile waveErrorFigure.pdf figures/waveError || exit 1

python3 makeReadme.py || exit 1

#------------------------------------------------------------------------------
