cd "${0%/*}" || exit 1
. ${WM_PROJECT_DIR:?}/bin/tools/RunFunctions        # Tutorial run functions
#------------------------------------------------------------------------------
# A 3D standing wave in a closed cube with the surfacePosition and
# interfaceHeight function objects and OpenFOAM's profiling, in serial, or
# with -parallel on the processors of system/decomposeParDict. The lines are
# written to system/lineLocations by ../makeLines.py.
#
# Usage: Allrun [-parallel]
#------------------------------------------------------------------------------

python3 ../makeLines.py . > log.makeLines 2>&1 || exit 1
restore0Dir
runApplication blockMesh
runApplication setAlphaField

if isParallel "$@"
then
    runApplication decomposePar -cellDist
    runParallel $(getApplication)
else
    runApplication $(getApplication)
fi

#------------------------------------------------------------------------------
