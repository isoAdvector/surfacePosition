FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      blockMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Closed 1 m cube with n^3 cells

scale   1;

L   1;
n   100;

vertices
(
    (0 0 0)
    ($L 0 0)
    ($L $L 0)
    (0 $L 0)
    (0 0 $L)
    ($L 0 $L)
    ($L $L $L)
    (0 $L $L)
);

blocks
(
    hex (0 1 2 3 4 5 6 7) ($n $n $n) simpleGrading (1 1 1)
);

boundary
(
    walls
    {
        type wall;
        faces
        (
            (0 4 7 3)
            (1 2 6 5)
            (0 1 5 4)
            (3 7 6 2)
            (0 3 2 1)
            (4 5 6 7)
        );
    }
);

