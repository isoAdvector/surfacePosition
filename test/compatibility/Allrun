cd "${0%/*}" || exit 1
#------------------------------------------------------------------------------
# Compatibility of surfacePosition with the OpenFOAM installations found in
# FOAM_INSTALLS (default ~/OpenFOAM) that have src/transportModels/geometricVoF
# (OpenFOAM.com v2006 and later). For each version:
#   - is it built, and do its applications run (with its MPI, or only in
#     serial with the dummy MPI library)?
#   - does surfacePosition compile with it (library in work/<version>/lib)?
#     If coordSet.H is not found (before v2206), it is built again with
#     fileFormats on the include path to list the remaining errors.
#   - do the specialCases and movingMesh tests pass with that library (in
#     serial and parallel, or only in serial without a working MPI)? The
#     cases of a failed test whose solver did not finish are cleaned and run
#     again with their Allrun without function objects
#     (withoutFunctionObjects.py), to see whether the failure is the
#     solver's.
# The versions are tested at the same time, in groups on 8 cores each.
# Writes log.compatibility and results.json (summarise.py).
#
# Environment variables:
#   FOAM_INSTALLS   directory with the OpenFOAM-<version> installations
#   TIME_LIMIT      time limit of each test and solver run in seconds
#                   (default 150), for solvers that diverge instead of failing
#------------------------------------------------------------------------------

installs=${FOAM_INSTALLS:-$HOME/OpenFOAM}
timeLimit=${TIME_LIMIT:-150}
src=$(cd ../.. && pwd)
work=$(pwd)/work

rm -rf "$work"
mkdir -p "$work"

# One installation per version: the first directory with the sources whose
# bashrc gives the version and that is built, else the first one
declare -A dirs
for d in "$installs"/OpenFOAM-*
do
    [ -f "$d/etc/bashrc" ] && [ -d "$d/src/transportModels/geometricVoF" ] || continue
    v=$(sed -n 's/^export WM_PROJECT_VERSION=\(v[0-9]*\).*/\1/p' "$d/etc/bashrc" | head -1)
    [ -n "$v" ] || continue
    built=$(ls "$d"/platforms/*/lib/libgeometricVoF.so 2>/dev/null | head -1)
    if [ -z "${dirs[$v]}" ] || { [ -n "$built" ] && [ -z "$(ls "${dirs[$v]}"/platforms/*/lib/libgeometricVoF.so 2>/dev/null)" ]; }
    then
        dirs[$v]=$d
    fi
done
versions=$(printf '%s\n' "${!dirs[@]}" | sort)

# Check, build and test one version
check()
{
    local v=$1 d=$2 cores=$3
    local w=$work/$v
    mkdir -p "$w/src" "$w/lib"
    echo "$d" > "$w/install"

    if [ -z "$(ls "$d"/platforms/*/lib/libgeometricVoF.so 2>/dev/null)" ]
    then
        echo "not built" > "$w/state"
        return
    fi

    local mplib=""
    if ! bash -c "source $d/etc/bashrc >/dev/null 2>&1; interIsoFoam -help >/dev/null 2>&1"
    then
        if bash -c "source $d/etc/bashrc WM_MPLIB=dummy >/dev/null 2>&1; interIsoFoam -help >/dev/null 2>&1"
        then
            mplib="WM_MPLIB=dummy"
            echo "serial only" > "$w/state"
        else
            echo "does not run" > "$w/state"
            return
        fi
    else
        echo "runs" > "$w/state"
    fi

    cp "$src"/surfacePosition.[CH] "$w/src/"
    cp -r "$src/Make" "$w/src/"
    rm -rf "$w"/src/Make/linux64* "$w"/src/Make/darwin*

    bash -c "source $d/etc/bashrc $mplib >/dev/null 2>&1
        export FOAM_USER_LIBBIN=$w/lib
        cd $w/src && wmake libso" > "$w/log.wmake" 2>&1
    echo $? > "$w/compiled"

    # Versions before v2206 have coordSet.H in fileFormats: build again with
    # it on the include path, to list the remaining obstacles
    if grep -q "coordSet.H: No such file" "$w/log.wmake"
    then
        cp -r "$w/src" "$w/src2"
        rm -rf "$w"/src2/Make/linux64*
        sed -i 's|-I$(LIB_SRC)/sampling/lnInclude \\|&\n    -I$(LIB_SRC)/fileFormats/lnInclude \\|' \
            "$w/src2/Make/options"
        bash -c "source $d/etc/bashrc $mplib >/dev/null 2>&1
            export FOAM_USER_LIBBIN=$w/lib2
            cd $w/src2 && wmake libso" > "$w/log.wmake2" 2>&1
    fi

    [ "$(cat "$w/compiled")" = 0 ] || return

    # Without a working MPI, the tests run only in serial
    local serial=""
    [ -n "$mplib" ] && serial="export SERIAL_ONLY=1"

    cp -r "$src/test/specialCases" "$src/test/movingMesh" "$w/"
    for t in specialCases movingMesh
    do
        "$w/$t/Allclean" > /dev/null 2>&1
        bash -c "source $d/etc/bashrc $mplib >/dev/null 2>&1
            export FOAM_USER_LIBBIN=$w/lib
            export LD_LIBRARY_PATH=$w/lib:\$LD_LIBRARY_PATH
            export OMPI_MCA_hwloc_base_binding_policy=none
            $serial
            timeout --kill-after=10 $timeLimit taskset -c $cores $w/$t/Allrun" \
            > "$w/$t/log.Allrun" 2>&1
        local status=$?
        echo $status > "$w/$t/status"
        [ $status = 0 ] && continue

        # Cases whose solver did not finish, again without function objects:
        # a cleaned copy run with its Allrun
        local c name app parallel
        for c in "$w/$t"/*/
        do
            name=$(basename "$c")
            [ -x "$c/Allrun" ] || continue
            case "$name" in baseCase|*Base) continue ;; esac
            app=$(sed -n 's/^application *\([^;]*\);.*/\1/p' "$c/system/controlDict")
            [ -f "$c/log.$app" ] && ! grep -q "^End" "$c/log.$app" || continue

            parallel=""
            ls -d "$c"/processor* > /dev/null 2>&1 && parallel=-parallel
            mkdir -p "$w/$t/withoutFO"
            cp -r "$c" "$w/$t/withoutFO/$name"
            "$w/$t/withoutFO/$name/Allclean" > /dev/null 2>&1
            python3 withoutFunctionObjects.py "$w/$t/withoutFO/$name"

            bash -c "source $d/etc/bashrc $mplib >/dev/null 2>&1
                export OMPI_MCA_hwloc_base_binding_policy=none
                timeout --kill-after=10 $timeLimit taskset -c $cores \
                    $w/$t/withoutFO/$name/Allrun $parallel" \
                > "$w/$t/withoutFO/$name/log.Allrun" 2>&1
            if grep -q "^End" "$w/$t/withoutFO/$name/log.$app" 2>/dev/null
            then
                echo "$name finishes" >> "$w/$t/withoutFO/result"
            else
                echo "$name fails" >> "$w/$t/withoutFO/result"
            fi
        done
    done
}

# The versions in nGroups groups at the same time, each on its own cores
# (the largest test uses 8 processes), each group one version after another
nCores=$(lscpu -p=CORE | grep -v '^#' | sort -un | wc -l)
nGroups=$((nCores/8 > 0 ? nCores/8 : 1))
groupCores=$((nCores/nGroups))
declare -a groups
group=0
for v in $versions
do
    groups[$group]="${groups[$group]} $v"
    group=$(((group + 1) % nGroups))
done

echo "Versions: $(echo $versions)"
for ((g = 0; g < nGroups; ++g))
do
    (
        for v in ${groups[$g]}
        do
            check "$v" "${dirs[$v]}" "$((g*groupCores))-$(((g + 1)*groupCores - 1))"
        done
    ) &
done
wait

python3 summarise.py "$work" | tee log.compatibility

#------------------------------------------------------------------------------
