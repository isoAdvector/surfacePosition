cd "${0%/*}" || exit 1
#------------------------------------------------------------------------------
# Special cases for surfacePosition: interfaces and lines on faces, edges and
# points of the mesh, on processor and cyclic faces, and line locations
# outside the mesh. One short interIsoFoam step per scenario, in serial and
# on 8 processors (only serial if SERIAL_ONLY is set), checked against the
# exact positions by check.py. The cases are copies of baseCase, run with
# its Allrun.
#------------------------------------------------------------------------------

# name origin normal (water on the side the normal points to); layers adds a
# layer of water at 0.6 < z < 0.75 above the water below z = 0.35
scenarios="flat537 (0 0 0.537) (0 0 -1)
flat500 (0 0 0.5) (0 0 -1)
flat300 (0 0 0.3) (0 0 -1)
slab (0.5 0 0) (-1 0 0)
layers (0 0 0.35) (0 0 -1)"

names=""
while read -r name ox oy oz nx ny nz
do
    names="$names $name"
    rm -rf "$name" "${name}_parallel"
    cp -r baseCase "$name"
    sed -i "s/^origin .*/origin          $ox $oy $oz;/; s/^normal .*/normal          $nx $ny $nz;/" "$name/system/setAlphaFieldDict"

    [ "$name" = layers ] && cp addLayer.py "$name/"

    [ -n "$SERIAL_ONLY" ] || cp -r "$name" "${name}_parallel"

    "$name/Allrun"
    [ -n "$SERIAL_ONLY" ] || "${name}_parallel/Allrun" -parallel
done <<< "$scenarios"

python3 check.py $names | tee log.check
exit "${PIPESTATUS[0]}"

#------------------------------------------------------------------------------
