cd "${0%/*}" || exit 1
. ${WM_PROJECT_DIR:?}/bin/tools/RunFunctions        # Tutorial run functions
#------------------------------------------------------------------------------
# One interIsoFoam step on a unit cube with the surfacePosition and
# interfaceHeight function objects, in serial, or with -parallel on the
# processors of system/decomposeParDict. The water is set by setAlphaField
# (system/setAlphaFieldDict) and, if the case has addLayer.py, a layer of
# water is added above it.
#
# Usage: Allrun [-parallel]
#------------------------------------------------------------------------------

restore0Dir
runApplication blockMesh
runApplication setAlphaField
if [ -f addLayer.py ]
then
    python3 addLayer.py > log.addLayer 2>&1 || exit 1
fi

if isParallel "$@"
then
    runApplication decomposePar -cellDist
    runParallel $(getApplication)
else
    runApplication $(getApplication)
fi

#------------------------------------------------------------------------------
